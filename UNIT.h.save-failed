/**
 * @file UNIT.H
 * @brief Header file for the UNIT class representing an academic unit.
 * @author Ye Min Aung
 * @date 2026-09-03
 */

#ifndef UNIT_H
#define UNIT_H

#include <iostream>

using namespace std;

const unsigned UNITIdSize = 10;   ///< Maximum size allowed for the Unit ID buffer
const unsigned UNITNameSize = 50;  ///< Maximum size allowed for the Unit Name buffer

/**
 * @class UNIT
 * @brief Represents an academic unit with a unit ID, name, section, and credit points.
 */
class UNIT {
public:
  /**
   * @brief Default constructor for UNIT.
   * Initializes member string variables to empty strings and numeric fields to zero.
   */
  UNIT();

  /**
   * @brief Parameterized constructor for UNIT.
   * @param id Pointer to a null-terminated character array representing the unit ID.
   * @param nam Pointer to a null-terminated character array representing the unit name.
   * @param sect Character representing the section designation.
   * @param cred Unsigned integer representing the credit point value.
   */
  UNIT(const char* id, const char* nam, char sect, unsigned cred);

  /**
   * @brief Accessor to retrieve the unit's credit points.
   * @return unsigned The number of credit points.
   */
  unsigned GetCredits() const;

  /**
   * @brief Mutator to set or update the unit's credit points.
   * @param cred Unsigned integer representing the new credit point value.
   */
  void SetCredits(unsigned cred);

  /**
   * @brief Overloaded stream insertion operator for outputting UNIT details.
   * @param os Reference to the output stream object.
   * @param U Constant reference to the UNIT object to be output.
   * @return ostream& Reference to the modified output stream.
   */
  friend ostream & operator <<(ostream & os, const UNIT & U);

  /**
   * @brief Overloaded stream extraction operator for reading UNIT details.
   * @param input Reference to the input stream object.
   * @param U Reference to the UNIT object to populate.
   * @return istream& Reference to the modified input stream.
   */
  friend istream & operator >>(istream & input, UNIT & U);

private:
  char unitId[UNITIdSize];  ///< C-style string array storing unit ID/code
  char name[UNITNameSize];  ///< C-style string array storing unit title/name
  char section;             ///< Character storing section identifier
  int credits;              ///< Credit value of the unit
};

/**
 * @brief Inlined getter function to retrieve credit points.
 * @return unsigned The number of credits.
 */
inline unsigned UNIT::GetCredits() const
{
  return credits;
}

/**
 * @brief Inlined setter function to assign credit points.
 * @param cred Unsigned integer representing credit points.
 */
inline void UNIT::SetCredits(unsigned cred)
{
  credits = cred;
}

#endif // UNIT_H
